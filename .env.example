# Core service
APP_ENV=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/revenue_agent
AUTO_CREATE_SCHEMA=false
PUBLIC_BASE_URL=http://localhost:8000
# Optional locally; required for cost-bearing POST endpoints when set.
WORKFLOW_API_KEY=

# Claude. Never commit the real key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_MAX_TOKENS=1800
CLAUDE_REQUESTS_PER_MINUTE=20
CLAUDE_MAX_RETRIES=4
CLAUDE_MONTHLY_BUDGET_USD=10.00

# Prices are configuration, not hard-coded claims. These defaults match Claude
# Sonnet 5 introductory API pricing checked on 2026-08-27; update when pricing changes.
CLAUDE_INPUT_USD_PER_MILLION=2.00
CLAUDE_OUTPUT_USD_PER_MILLION=10.00

# Public source
OPENFDA_API_KEY=
OPENFDA_TIMEOUT_SECONDS=20

# External writes are impossible unless this master switch and a provider switch
# are both true. Preview mode needs no credentials.
LIVE_INTEGRATIONS_ENABLED=false
SALESFORCE_LIVE_ENABLED=false
SALESFORCE_INSTANCE_URL=
SALESFORCE_ACCESS_TOKEN=
HUBSPOT_LIVE_ENABLED=false
HUBSPOT_ACCESS_TOKEN=
CLAY_LIVE_ENABLED=false
CLAY_WEBHOOK_URL=
CLAY_WEBHOOK_SECRET=
